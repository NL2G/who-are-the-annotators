# Azure OpenAI Batch API Configuration
# Copy this file to azure_batch.env and fill in your values

# Azure OpenAI endpoint (e.g. https://your-resource.openai.azure.com/)
AZURE_API_URL=

# Azure OpenAI API key
AZURE_API_KEY=

# API version (2025-04-01-preview supports batch API)
AZURE_API_VERSION=2025-04-01-preview

# Deployment name (e.g. gpt-4.1, gpt-4.1-global-batch)
AZURE_ENGINE_NAME=gpt-4.1
