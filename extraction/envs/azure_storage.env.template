# Azure Blob Storage Configuration
# Copy this file to azure_storage.env and fill in your values

# Option 1: Connection string (easiest)
AZURE_STORAGE_CONNECTION_STRING=

# Option 2: SAS token (include leading ?)
AZURE_STORAGE_SAS_TOKEN=

# Storage account URL (required for SAS token or DefaultAzureCredential)
AZURE_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net

# Container name for batch input/output files
AZURE_STORAGE_CONTAINER_NAME=batch-input
